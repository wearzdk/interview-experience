---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { companyHue, companyInitial } from '../lib/company-hue';

const interviews = await getCollection('interviews');
const companyCounts = Object.entries(
	interviews.reduce((acc, i) => ({ ...acc, [i.data.company]: (acc[i.data.company] ?? 0) + 1 }), {} as Record<string, number>)
).sort((a, b) => b[1] - a[1]);

const title = `全部公司 — 共 ${companyCounts.length} 家公司面经`;
const description = `收录${companyCounts.length}家互联网公司的真实面经，包括${companyCounts.slice(0, 5).map(([c]) => c).join('、')}等大厂。`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": title,
			"description": description,
			"url": `${Astro.site}companies/`,
			"numberOfItems": companyCounts.length,
		})} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader crumbs={[{ label: '全部公司' }]} title="全部公司">
				共收录 <strong>{companyCounts.length}</strong> 家公司的面经
			</PageHeader>

			<div class="grid">
				{companyCounts.map(([company, count]) => (
					<a href={`/company/${company}/`} class="grid-item">
						<span class="co-badge" style={`--co-hue:${companyHue(company)}`} aria-hidden="true">{companyInitial(company)}</span>
						<span class="grid-name">{company}</span>
						<span class="grid-count">{count}</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: 0.75rem;
	}

	.grid-item {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.7rem 0.85rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	.grid-item:hover {
		border-color: var(--color-accent-border);
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}

	.grid-item:hover .grid-name {
		color: var(--color-accent);
	}

	.grid-item .co-badge {
		width: 2.1rem;
		height: 2.1rem;
		font-size: 0.85rem;
	}

	.grid-name {
		flex: 1;
		min-width: 0;
		font-size: 0.9rem;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.grid-count {
		flex-shrink: 0;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		background: var(--color-bg-deep);
		padding: 0.1rem 0.5rem;
		border-radius: var(--radius-full);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
		.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
		.grid-item { padding: 0.55rem 0.6rem; gap: 0.5rem; }
		.grid-item .co-badge { width: 1.85rem; height: 1.85rem; font-size: 0.78rem; }
		.grid-name { font-size: 0.85rem; }
	}
</style>
