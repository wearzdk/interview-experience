---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MiniProgram from '../../components/MiniProgram.astro';
import { mainSiteUrl } from '../../consts';
import { companyHue, companyInitial } from '../../lib/company-hue';
import { tagToSlug } from '../../lib/tag-slug';

export async function getStaticPaths() {
	const interviews = await getCollection('interviews');
	return interviews.map(entry => ({
		params: { slug: entry.id },
		props: { entry, allInterviews: interviews },
	}));
}

const { entry, allInterviews } = Astro.props;
const { Content } = await render(entry);

const description = entry.data.summary
	?? `${entry.data.company} ${entry.data.position}${entry.data.round ? ' ' + entry.data.round : ''} 真实面经，涵盖${entry.data.tags.slice(0, 4).join('、')}等考点。`;

// 相关推荐：打分机制，同公司+2、同岗位+1、每个相同tag+1，取前5
const currentTags = new Set(entry.data.tags);
const related = allInterviews
	.filter(i => i.id !== entry.id)
	.map(i => {
		let score = 0;
		if (i.data.company === entry.data.company) score += 2;
		if (i.data.position === entry.data.position) score += 1;
		score += i.data.tags.filter(t => currentTags.has(t)).length;
		return { ...i, score };
	})
	.filter(i => i.score > 0)
	.sort((a, b) => b.score - a.score || b.data.date.localeCompare(a.data.date))
	.slice(0, 5);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Article",
			"headline": entry.data.title,
			"description": description,
			"datePublished": entry.data.date + "-01",
			"author": { "@type": "Organization", "name": "面灵面经" },
			"publisher": {
				"@type": "Organization",
				"name": "面灵AI",
				"url": "https://www.mianlingai.com",
			},
			"keywords": [entry.data.company, entry.data.position, ...entry.data.tags].join(', '),
			"url": `${Astro.site}interview/${entry.id}/`,
			"mentions": {
				"@type": "SoftwareApplication",
				"name": "面灵AI",
				"url": "https://www.mianlingai.com",
				"description": "实时面试辅助工具，面试中实时提供答案参考和编程题解答"
			}
		},
		{
			"@type": "BreadcrumbList",
			"itemListElement": [
				{ "@type": "ListItem", "position": 1, "name": "首页", "item": `${Astro.site}` },
				{ "@type": "ListItem", "position": 2, "name": entry.data.company, "item": `${Astro.site}company/${entry.data.company}/` },
				{ "@type": "ListItem", "position": 3, "name": entry.data.title }
			]
		}
	]
};

const facts = [
	entry.data.round && { label: '轮次', value: entry.data.round },
	entry.data.base && { label: 'base', value: entry.data.base },
	entry.data.result && { label: '结果', value: entry.data.result },
	{ label: '时间', value: entry.data.date },
	{ label: '来源', value: entry.data.source },
].filter(Boolean) as { label: string; value: string }[];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${entry.data.title} — ${entry.data.company}面试真题`}
			description={description}
			ogType="article"
			publishedTime={entry.data.date + "-01"}
		/>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<nav class="breadcrumb" aria-label="面包屑">
					<a href="/">首页</a>
					<span aria-hidden="true">/</span>
					<a href={`/company/${entry.data.company}/`}>{entry.data.company}</a>
					<span aria-hidden="true">/</span>
					<span class="crumb-current">{entry.data.title}</span>
				</nav>

				<header class="article-header">
					<div class="title-row">
						<span class="co-badge" style={`--co-hue:${companyHue(entry.data.company)}`} aria-hidden="true">
							{companyInitial(entry.data.company)}
						</span>
						<div>
							<div class="meta-line">
								<a href={`/company/${entry.data.company}/`} class="company">{entry.data.company}</a>
								<span class="dot" aria-hidden="true">·</span>
								<a href={`/position/${entry.data.position}/`} class="position">{entry.data.position}</a>
							</div>
							<h1>{entry.data.title}</h1>
						</div>
					</div>

					<dl class="facts">
						{facts.map(fact => (
							<div class="fact">
								<dt>{fact.label}</dt>
								<dd>{fact.value}</dd>
							</div>
						))}
					</dl>

					{entry.data.tags.length > 0 && (
						<div class="tags">
							{entry.data.tags.map(tag => (
								<a href={`/tag/${tagToSlug(tag)}/`} class="tag">{tag}</a>
							))}
						</div>
					)}
				</header>

				<div class="content">
					<Content />
				</div>

				<div class="article-footer">
					<a href={mainSiteUrl('interview')} target="_blank" rel="noopener" class="cta-banner" data-umami-event="cta-interview">
						<div class="cta-content">
							<strong>面灵AI — AI实时面试助手</strong>
							<span>实时语音识别 + AI智能回答，轻松应对 {entry.data.company} 等大厂面试</span>
						</div>
						<span class="cta-arrow" aria-hidden="true">→</span>
					</a>
					<MiniProgram variant="banner" />
				</div>

				{related.length > 0 && (
					<section class="related">
						<h2>相关面经</h2>
						<div class="related-list">
							{related.map(item => (
								<a href={`/interview/${item.id}/`} class="related-item">
									<span class="related-title">{item.data.title}</span>
									<span class="related-meta">{item.data.company} · {item.data.position}{item.data.round ? ' · ' + item.data.round : ''}</span>
								</a>
							))}
						</div>
					</section>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 780px;
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		color: var(--color-muted);
		margin-bottom: var(--space-sm);
	}
	.breadcrumb > span { color: var(--color-border-strong); }
	.breadcrumb a:hover { color: var(--color-accent); }
	.crumb-current {
		color: var(--color-muted) !important;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 22em;
	}

	.article-header {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1.5rem;
		box-shadow: var(--shadow-sm);
		margin-bottom: var(--space-md);
	}

	.title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.title-row .co-badge {
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.05rem;
		margin-top: 0.15rem;
	}

	.meta-line {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: 0.83rem;
		margin-bottom: 0.35rem;
	}

	.company, .position { font-weight: 600; color: var(--color-accent); }
	.company:hover, .position:hover { text-decoration: underline; }
	.dot { color: var(--color-border-strong); }

	.article-header h1 {
		font-size: 1.6rem;
		font-weight: 800;
		line-height: 1.35;
		letter-spacing: -0.025em;
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.1rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--color-border);
	}

	.fact {
		display: flex;
		align-items: baseline;
		gap: 0.35rem;
		padding: 0.25rem 0.65rem;
		background: var(--color-bg);
		border-radius: var(--radius-sm);
		font-size: 0.78rem;
	}

	.fact dt { color: var(--color-muted); }
	.fact dd { font-weight: 600; color: var(--color-text-secondary); }

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.75rem;
	}

	.tag {
		padding: 0.2rem 0.6rem;
		background: var(--color-accent-lighter);
		border: 1px solid var(--color-accent-border);
		border-radius: var(--radius-full);
		font-size: 0.76rem;
		font-weight: 500;
		color: var(--color-accent);
	}
	.tag:hover {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: #fff;
	}

	.content {
		line-height: 1.85;
		font-size: 0.95rem;
		color: var(--color-text-secondary);
	}
	.content :global(h2) {
		font-size: 1.25rem;
		margin-top: 2.25rem;
		margin-bottom: 0.75rem;
		font-weight: 700;
		color: var(--color-text);
		padding-left: 0.7rem;
		border-left: 3px solid var(--color-accent);
	}
	.content :global(h3) {
		font-size: 1.05rem;
		margin-top: 1.6rem;
		margin-bottom: var(--space-xs);
		font-weight: 600;
		color: var(--color-text);
	}
	.content :global(p) { margin-bottom: var(--space-sm); }
	.content :global(ul), .content :global(ol) { margin: var(--space-sm) 0; padding-left: 1.4rem; }
	.content :global(li) { margin-bottom: 0.4rem; }
	.content :global(li)::marker { color: var(--color-accent); }
	.content :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
	.content :global(pre) {
		font-size: 0.86rem;
		margin: var(--space-sm) 0;
	}
	.content :global(code) { font-family: var(--font-mono); font-size: 0.88em; }
	.content :global(strong) { font-weight: 600; color: var(--color-text); }
	.content :global(hr) { border: none; border-top: 1px solid var(--color-border); margin: var(--space-md) 0; }
	.content :global(blockquote) {
		border-left: 3px solid var(--color-accent-border);
		background: var(--color-accent-lighter);
		border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
		padding: 0.75rem 1rem;
		margin: var(--space-sm) 0;
		color: var(--color-text-secondary);
	}
	.content :global(blockquote p:last-child) { margin-bottom: 0; }

	.article-footer {
		margin-top: var(--space-lg);
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.cta-banner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		background: var(--color-accent-gradient);
		border-radius: var(--radius-lg);
		padding: 1.25rem 1.5rem;
		color: #fff;
		box-shadow: var(--shadow-accent);
	}
	.cta-banner:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
	}
	.cta-content { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
	.cta-content strong { font-size: 1rem; letter-spacing: -0.01em; }
	.cta-content span { color: rgba(255, 255, 255, 0.82); font-size: 0.83rem; line-height: 1.5; }
	.cta-arrow { font-size: 1.35rem; flex-shrink: 0; transition: transform 0.15s ease; }
	.cta-banner:hover .cta-arrow { transform: translateX(3px); }

	.related {
		margin-top: var(--space-md);
		padding-top: var(--space-md);
		border-top: 1px solid var(--color-border);
	}

	.related h2 {
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin-bottom: 0.85rem;
	}

	.related-list { display: flex; flex-direction: column; gap: 0.4rem; }

	.related-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.7rem 0.85rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.related-item:hover {
		border-color: var(--color-accent-border);
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}
	.related-item:hover .related-title { color: var(--color-accent); }

	.related-title { font-size: 0.9rem; font-weight: 600; color: var(--color-text); }
	.related-meta { font-size: 0.78rem; color: var(--color-muted); }

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
		.crumb-current { max-width: 10em; }
		.article-header { padding: 1.1rem; }
		.article-header h1 { font-size: 1.3rem; }
		.title-row .co-badge { width: 2.25rem; height: 2.25rem; font-size: 0.9rem; }
		.cta-banner { flex-direction: column; align-items: flex-start; gap: 0.75rem; padding: 1.1rem; }
	}
</style>
