---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InterviewList from '../components/InterviewList.astro';
import MiniProgram from '../components/MiniProgram.astro';
import Pagination from '../components/Pagination.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { tagToSlug } from '../lib/tag-slug';

export const getStaticPaths = (async ({ paginate }) => {
	const interviews = await getCollection('interviews');
	const sorted = interviews.sort((a, b) => b.data.date.localeCompare(a.data.date));
	return paginate(sorted, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const interviews = await getCollection('interviews');

// 按面经数量降序排列
const companyCounts = interviews.reduce((acc, i) => ({ ...acc, [i.data.company]: (acc[i.data.company] ?? 0) + 1 }), {} as Record<string, number>);
const topCompanies = Object.entries(companyCounts).sort((a, b) => b[1] - a[1]).slice(0, 12);

const positionCounts = interviews.reduce((acc, i) => ({ ...acc, [i.data.position]: (acc[i.data.position] ?? 0) + 1 }), {} as Record<string, number>);
const topPositions = Object.entries(positionCounts).sort((a, b) => b[1] - a[1]).slice(0, 10);

const tagCounts = interviews.flatMap(i => i.data.tags).reduce((acc, t) => ({ ...acc, [t]: (acc[t] ?? 0) + 1 }), {} as Record<string, number>);
const topTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]).slice(0, 15);

const isFirstPage = page.currentPage === 1;
const pageTitle = isFirstPage ? SITE_TITLE : `${SITE_TITLE} - 第 ${page.currentPage} 页`;
const pageDesc = isFirstPage
	? SITE_DESCRIPTION
	: `第 ${page.currentPage} 页 · ${SITE_DESCRIPTION}`;

const stats = [
	{ num: interviews.length, label: '篇面经' },
	{ num: Object.keys(companyCounts).length, label: '家公司' },
	{ num: Object.keys(positionCounts).length, label: '个岗位' },
];

const filterGroups = [
	{ title: '公司', all: '/companies/', items: topCompanies.map(([name, n]) => ({ name, n, href: `/company/${name}/` })) },
	{ title: '岗位', all: '/positions/', items: topPositions.map(([name, n]) => ({ name, n, href: `/position/${name}/` })) },
	{ title: '技术点', all: '/tags/', items: topTags.map(([name, n]) => ({ name, n, href: `/tag/${tagToSlug(name)}/` })) },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} noindex={!isFirstPage} />
		{page.url.prev && <link rel="prev" href={page.url.prev} />}
		{page.url.next && <link rel="next" href={page.url.next} />}
	</head>
	<body>
		<Header />
		<main>
			{isFirstPage && (
				<section class="hero">
					<div class="hero-text">
						<p class="eyebrow"><span class="pulse"></span>每日自动采集 · 牛客 / 脉脉</p>
						<h1>互联网大厂面经<br /><span class="hero-accent">Java · 后端 · 前端 · AI 真题聚合</span></h1>
						<p class="hero-desc">聚合牛客、脉脉等平台的字节、阿里、腾讯、美团等大厂真实面试题与解析，按公司、岗位、技术点整理成可检索的题库。</p>
						<div class="hero-stats">
							{stats.map(({ num, label }) => (
								<div class="stat">
									<span class="stat-num">{num}</span>
									<span class="stat-label">{label}</span>
								</div>
							))}
						</div>
					</div>
					<aside class="hero-side">
						<MiniProgram variant="card" />
					</aside>
				</section>
			)}

			{isFirstPage && (
				<section class="filters" aria-label="快速筛选">
					{filterGroups.map((group) => (
						<div class="filter-group">
							<div class="filter-header">
								<h2>{group.title}</h2>
								<a href={group.all} class="view-all">全部 &rarr;</a>
							</div>
							<div class="filter-tags">
								{group.items.map((item) => (
									<a href={item.href}>{item.name}<span class="tag-count">{item.n}</span></a>
								))}
							</div>
						</div>
					))}
				</section>
			)}

			<section class="list">
				<div class="list-header">
					<h2>{isFirstPage ? '最新面经' : '面经列表'}</h2>
					<span class="list-count">共 {page.total} 篇 · 第 {page.currentPage}/{page.lastPage} 页</span>
				</div>
				<InterviewList items={page.data} />
				<Pagination
					current={page.currentPage}
					last={page.lastPage}
					prevUrl={page.url.prev}
					nextUrl={page.url.next}
				/>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: 0 2rem;
	}

	/* Hero */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 3rem;
		align-items: center;
		padding: var(--space-lg) 0 var(--space-md);
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.8rem 0.3rem 0.6rem;
		border-radius: var(--radius-full);
		background: var(--color-card);
		border: 1px solid var(--color-accent-border);
		color: var(--color-accent);
		font-size: 0.78rem;
		font-weight: 600;
		box-shadow: var(--shadow-sm);
	}

	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 3px rgba(16, 95, 217, 0.16);
	}

	.hero-text h1 {
		font-size: 3rem;
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.035em;
		margin: 1rem 0 0.85rem;
	}

	.hero-accent {
		background: var(--color-accent-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero-desc {
		color: var(--color-text-secondary);
		font-size: 1rem;
		line-height: 1.7;
		max-width: 34em;
		margin-bottom: 1.75rem;
	}

	.hero-stats {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.75rem 1.25rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
		min-width: 6.25rem;
	}

	.stat-num {
		font-size: 1.6rem;
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
		background: var(--color-accent-gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.stat-label {
		font-size: 0.78rem;
		color: var(--color-muted);
		font-weight: 500;
	}

	/* 筛选区 */
	.filters {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		padding: var(--space-sm) 0 var(--space-md);
	}

	.filter-group {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 1.25rem;
		box-shadow: var(--shadow-sm);
	}

	.filter-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.85rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--color-border);
	}

	.filter-group h2 {
		font-size: 0.78rem;
		color: var(--color-muted);
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.view-all {
		font-size: 0.75rem;
		color: var(--color-accent);
		font-weight: 600;
	}

	.view-all:hover {
		color: var(--color-accent-hover);
	}

	.filter-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.filter-tags a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.3rem 0.7rem;
		background: var(--color-bg);
		border: 1px solid transparent;
		border-radius: var(--radius-full);
		font-size: 0.82rem;
		color: var(--color-text-secondary);
	}

	.filter-tags a:hover {
		background: var(--color-accent-light);
		border-color: var(--color-accent-border);
		color: var(--color-accent);
	}

	.tag-count {
		font-size: 0.7rem;
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.filter-tags a:hover .tag-count {
		color: var(--color-accent);
	}

	/* 列表 */
	.list {
		padding: 0 0 var(--space-lg);
	}

	.list-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: var(--space-sm);
	}

	.list-header h2 {
		font-size: 1.25rem;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.list-count {
		font-size: 0.8rem;
		color: var(--color-muted);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 1000px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-top: var(--space-md);
		}
		.hero-side { max-width: 320px; }
		.hero-text h1 { font-size: 2.4rem; }
		.filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.filters .filter-group:last-child { grid-column: 1 / -1; }
	}

	@media (max-width: 768px) {
		main { padding: 0 1rem; }
		.hero { padding: var(--space-sm) 0 var(--space-sm); gap: 1.5rem; }
		.hero-side { max-width: none; margin-inline: auto; width: 100%; }
		.hero-text h1 { font-size: 1.9rem; margin: 0.85rem 0 0.6rem; }
		.hero-desc { font-size: 0.92rem; margin-bottom: 1.25rem; }
		.hero-stats { gap: 0.5rem; }
		.stat { flex: 1; min-width: 0; padding: 0.6rem 0.75rem; align-items: center; }
		.stat-num { font-size: 1.3rem; }
		.filters { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
		.filters .filter-group:last-child { grid-column: auto; }
		.list-header { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
	}
</style>
