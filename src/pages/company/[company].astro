---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InterviewList from '../../components/InterviewList.astro';
import MiniProgram from '../../components/MiniProgram.astro';
import PageHeader from '../../components/PageHeader.astro';
import { companyHue, companyInitial } from '../../lib/company-hue';

export async function getStaticPaths() {
	const interviews = await getCollection('interviews');
	const companies = [...new Set(interviews.map(i => i.data.company))];

	return companies.map(company => ({
		params: { company },
		props: {
			company,
			interviews: interviews.filter(i => i.data.company === company)
				.sort((a, b) => b.data.date.localeCompare(a.data.date))
		},
	}));
}

const { company, interviews } = Astro.props;
const topPositions = [...new Set(interviews.map(i => i.data.position))].slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${company}面经`} description={`${company}真实面经分享`} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader
				crumbs={[{ label: '全部公司', href: '/companies/' }, { label: company }]}
				title={company}
				badge={companyInitial(company)}
				badgeHue={companyHue(company)}
			>
				共 <strong>{interviews.length}</strong> 篇面经{topPositions.length > 0 && ` · ${topPositions.join(' / ')}`}
			</PageHeader>

			<InterviewList items={interviews} hideCompany titleLevel={2} />

			<div class="page-mp">
				<MiniProgram variant="banner" />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.page-mp {
		margin-top: var(--space-md);
	}

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
	}
</style>
