---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const interviews = await getCollection('interviews');
const positionCounts = Object.entries(
	interviews.reduce((acc, i) => ({ ...acc, [i.data.position]: (acc[i.data.position] ?? 0) + 1 }), {} as Record<string, number>)
).sort((a, b) => b[1] - a[1]);

const title = `全部岗位 — 共 ${positionCounts.length} 个岗位面经`;
const description = `收录${positionCounts.length}个互联网岗位的真实面经，包括${positionCounts.slice(0, 5).map(([p]) => p).join('、')}等热门岗位。`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": title,
			"description": description,
			"url": `${Astro.site}positions/`,
			"numberOfItems": positionCounts.length,
		})} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader crumbs={[{ label: '全部岗位' }]} title="全部岗位">
				共收录 <strong>{positionCounts.length}</strong> 个岗位的面经
			</PageHeader>

			<div class="grid">
				{positionCounts.map(([position, count]) => (
					<a href={`/position/${position}/`} class="grid-item">
						<span class="grid-name">{position}</span>
						<span class="grid-count">{count}</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 0.75rem;
	}

	.grid-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.75rem 0.95rem;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-sm);
	}

	.grid-item:hover {
		border-color: var(--color-accent-border);
		box-shadow: var(--shadow-md);
		transform: translateY(-1px);
	}

	.grid-item:hover .grid-name {
		color: var(--color-accent);
	}

	.grid-name {
		font-size: 0.9rem;
		font-weight: 600;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
	}

	.grid-count {
		flex-shrink: 0;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--color-text-secondary);
		background: var(--color-bg-deep);
		padding: 0.1rem 0.5rem;
		border-radius: var(--radius-full);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
		.grid { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
	}
</style>
