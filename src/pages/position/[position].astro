---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InterviewList from '../../components/InterviewList.astro';
import MiniProgram from '../../components/MiniProgram.astro';
import PageHeader from '../../components/PageHeader.astro';

export async function getStaticPaths() {
	const interviews = await getCollection('interviews');
	const positions = [...new Set(interviews.map(i => i.data.position))];

	return positions.map(position => ({
		params: { position },
		props: {
			position,
			interviews: interviews.filter(i => i.data.position === position)
				.sort((a, b) => b.data.date.localeCompare(a.data.date))
		},
	}));
}

const { position, interviews } = Astro.props;
const topCompanies = [...new Set(interviews.map(i => i.data.company))].slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${position}面经`} description={`${position}真实面经分享`} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader
				crumbs={[{ label: '全部岗位', href: '/positions/' }, { label: position }]}
				title={position}
			>
				共 <strong>{interviews.length}</strong> 篇面经{topCompanies.length > 0 && ` · ${topCompanies.join(' / ')}`}
			</PageHeader>

			<InterviewList items={interviews} hidePosition titleLevel={2} />

			<div class="page-mp">
				<MiniProgram variant="banner" />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.page-mp {
		margin-top: var(--space-md);
	}

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
	}
</style>
