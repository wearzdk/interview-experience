---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InterviewList from '../../components/InterviewList.astro';
import MiniProgram from '../../components/MiniProgram.astro';
import PageHeader from '../../components/PageHeader.astro';
import { tagToSlug } from '../../lib/tag-slug';

export async function getStaticPaths() {
	const interviews = await getCollection('interviews');
	const allTags = [...new Set(interviews.flatMap(i => i.data.tags))];

	return allTags.map(tag => ({
		params: { tag: tagToSlug(tag) },
		props: {
			tag,
			interviews: interviews
				.filter(i => i.data.tags.includes(tag))
				.sort((a, b) => b.data.date.localeCompare(a.data.date))
		},
	}));
}

const { tag, interviews } = Astro.props;
const title = `${tag}面试题 — 真实面经汇总`;
const companies = [...new Set(interviews.map(i => i.data.company))];
const description = `收录 ${interviews.length} 篇含 ${tag} 考点的真实面经，涵盖${companies.slice(0, 5).join('、')}等大厂，帮你高效备战面试。`;
const isThin = interviews.length < 2;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		{isThin && <meta name="robots" content="noindex, follow" />}
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": title,
			"description": description,
			"url": `${Astro.site}tag/${tagToSlug(tag)}`,
			"numberOfItems": interviews.length,
		})} />
	</head>
	<body>
		<Header />
		<main>
			<PageHeader
				crumbs={[{ label: '全部技术点', href: '/tags/' }, { label: `${tag} 面试题` }]}
				title={`${tag} 面试题`}
			>
				共 <strong>{interviews.length}</strong> 篇真实面经{companies.length > 0 && ` · 涵盖 ${companies.slice(0, 5).join(' / ')} 等 ${companies.length} 家公司`}
			</PageHeader>

			<InterviewList items={interviews} titleLevel={2} />

			<div class="page-mp">
				<MiniProgram variant="banner" />
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-md) 2rem var(--space-lg);
	}

	.page-mp {
		margin-top: var(--space-md);
	}

	@media (max-width: 768px) {
		main { padding: var(--space-sm) 1rem var(--space-md); }
	}
</style>
