---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	crumbs: Crumb[];
	title: string;
	/** 标题前的小标记，如公司/岗位聚合页的首字标记 */
	badge?: string;
	badgeHue?: number;
}

const { crumbs, title, badge, badgeHue } = Astro.props;
---

<div class="page-header">
	<nav class="breadcrumb" aria-label="面包屑">
		<a href="/">首页</a>
		{crumbs.map((crumb) => (
			<>
				<span class="crumb-sep" aria-hidden="true">/</span>
				{crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
			</>
		))}
	</nav>
	<div class="title-row">
		{badge && (
			<span class="co-badge" style={badgeHue ? `--co-hue:${badgeHue}` : undefined} aria-hidden="true">{badge}</span>
		)}
		<h1>{title}</h1>
	</div>
	<p class="subtitle"><slot /></p>
</div>

<style>
	.page-header {
		margin-bottom: var(--space-md);
	}

	.breadcrumb {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		font-size: 0.8rem;
		color: var(--color-muted);
		margin-bottom: 0.85rem;
	}

	.breadcrumb a:hover { color: var(--color-accent); }
	.crumb-sep { color: var(--color-border-strong); }

	.title-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.title-row h1 {
		font-size: 1.9rem;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.title-row .co-badge {
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.05rem;
	}

	.subtitle {
		margin-top: 0.5rem;
		font-size: 0.88rem;
		color: var(--color-muted);
	}

	.subtitle :global(strong) {
		color: var(--color-accent);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 768px) {
		.page-header { margin-bottom: var(--space-sm); }
		.title-row h1 { font-size: 1.45rem; }
		.title-row .co-badge { width: 2.25rem; height: 2.25rem; font-size: 0.9rem; }
	}
</style>
